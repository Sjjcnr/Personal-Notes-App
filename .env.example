# Server Configuration
PORT=3500
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/notesdb

# Authentication
# In production (NODE_ENV=production), SESSION_SECRET is required and must be at least 32 characters.
# In development, if omitted, a temporary random secret is generated per-process.
SESSION_SECRET=your_long_random_session_secret_min_32_chars

# Google Gemini AI (Required for AI rewrite, auto-tag, chat, and generate)
GEMINI_API_KEY=your_gemini_api_key_here
